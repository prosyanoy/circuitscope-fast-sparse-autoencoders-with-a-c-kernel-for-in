# All variables are optional; defaults are shown. No secrets are needed.
CS_OUT_DIR=artifacts
CS_SEED=0
# Dyck task / transformer
CS_SEQ_LEN=24
CS_D_MODEL=64
CS_N_LAYERS=2
CS_MODEL_STEPS=1200
# Sparse autoencoder
CS_HOOK_LAYER=1
CS_N_FEATURES=512
CS_K=8
CS_SAE_STEPS=3000
CS_SAE_BACKEND=cpp   # cpp | torch (cpp falls back to torch if the extension is not built)
# OpenMP
# OMP_NUM_THREADS=4
